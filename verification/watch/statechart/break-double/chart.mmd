---
title: "Task sweep"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: quiet
    lg1: working
    lg2: noticed
    lg3: waiting
    lg4: Breaks OneNoticePerProgressStamp in some cases
    lg5: Path to the OneNoticePerProgressStamp bug
  }
  class lg0 yellow
  class lg1 blue
  class lg2 teal
  class lg3 orange
  class lg4 mayBreak
  class lg5 bugPath
  s0: Running, no sample
  s1: Running, sample saved
  s2: Waiting on the person
  s3: Waiting on a resource
  s4: Running, notice sent
  [*] --> s0
  s0 --> s1: a progress sample is saved
  s0 --> s2: the job waits on the person
  s0 --> s3: the job waits on a resource
  s1 --> s2: the job waits on the person
  s1 --> s3: the job waits on a resource
  s1 --> s4: the sweep runs
  s4 --> s2: the job waits on the person
  s4 --> s3: the job waits on a resource
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 yellow
  class s0 bugPath
  class s1 blue
  class s1 bugPath
  class s2 orange
  class s2 mayBreak
  class s3 orange
  class s3 mayBreak
  class s4 teal
  class s4 mayBreak
  class s4 bugPath
