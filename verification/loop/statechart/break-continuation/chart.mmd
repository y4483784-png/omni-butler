stateDiagram-v2
  state "Legend" as legend {
    lg0: main
    lg1: before
    lg2: after
    lg3: stopped
    lg4: Breaks ContinuationDueSurvivesCrash
    lg5: Path to the ContinuationDueSurvivesCrash bug
