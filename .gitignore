# Python
__pycache__/
*.py[cod]
.venv/
*.db
.deps/
.tB/
.env
.env.*
!.env.example
debug-*.log
debug-*.lo
*.log

# Node
node_modules/
dist/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# User uploads (must live outside repo; legacy path ignored if present)
backend/data/uploads/
**/uploads/

# TLS material (keep the example conf; never commit keys)
deploy/certs/*.pem
deploy/certs/*.key
deploy/nginx-tls.conf

# Test / eval runtime (keep datasets under data/eval/*.jsonl)
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/reports/*.json
backend/data/harness/
backend/data/eval/fixtures/_plan_join_*.csv
*_eval_latest.json

# Internal binary docs (keep in parent folder or company doc lib)
*.docx
*.doc

# YZ eval fixtures: GitHub 只保留 md/txt（虚构指南与制度样例）。
# csv / xlsx / pdf 含考勤明细或第三方报告，本机可留着跑评测，禁止入库。
backend/tests/YZ测试文档/*.csv
backend/tests/YZ测试文档/*.xlsx
backend/tests/YZ测试文档/*.pdf
backend/tests/YZ测试文档/*.docx
backend/tests/YZ测试文档/~$*

# Cursor debug dumps
.cursor/
