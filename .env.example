# ---- LLM（DeepSeek，OpenAI 兼容端点）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=120
# PRD：LLM 超时自动重试 3 次后再向用户报错
LLM_MAX_RETRIES=3
# 非法 json 会再请求一次，不由这个数字决定。ROUTER_MAX_ATTEMPTS 只限制限流或超时后的额外次数，保持 1。
CHAT_MODEL=deepseek-flash
CHAT_THINKING=on
PLANNER_MODEL=deepseek-flash
PLANNER_THINKING=off
ROUTER_MODEL=deepseek-flash
ROUTER_THINKING=off
JUDGE_MODEL=deepseek-v4-pro
JUDGE_THINKING=on
ROUTER_MAX_ATTEMPTS=1
# 依据核验：成稿后对照证据做 NLI；失败则带反馈再生成一次（false 则只附免责、不重写）
# GROUNDING_ENABLED=true
# GROUNDING_REPAIR_ENABLED=true

# ---- 智谱向量 / 多模态 OCR（Rerank 见下方 RAG 段）----
# 向量在 RAG_HYBRID_ENABLED=true 时必填；不用就设成 false（只剩关键词检索）。
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3-pro
# 多模态 OCR：PDF 页有嵌入图即识别；无图但有效字极少时兜底 OCR
# VISION_OCR_ENABLED=true 时 VISION_BASE_URL / VISION_API_KEY 必填；不用就设成 false
# VISION_MODEL：专属权益可用 glm-4v-flash；有 glm-4.6v 专属包时可改回
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
VISION_API_KEY=
VISION_MODEL=glm-4v-flash
VISION_OCR_ENABLED=true
OCR_MIN_USEFUL_CHARS=40
OCR_MAX_PAGES=80

# ---- 认证 / 多用户隔离 ----
# 生产务必修改 SECRET_KEY 与 ADMIN_PASSWORD；首次启动会用其创建/初始化管理员
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 生产必须改掉 SECRET_KEY / 管理员密码 / Postgres / MinIO 默认口令。
# 改完后可设 ENFORCE_SECURE_SECRETS=true，启动时若仍是默认值会拒绝起来。
ENFORCE_SECURE_SECRETS=false
# HTTPS 反代后可在 backend/.env 设 SESSION_COOKIE_SECURE=true

# ---- Google 日历（连接与令牌；未配置时日程仍只写本地）----
# Web 应用 OAuth 客户端。同意屏幕保持测试模式，并把要连接的 Google 账户加为测试用户。
# 请求的范围：calendar.events、calendar.settings.readonly、calendar.events.freebusy、
# gmail.readonly、drive.readonly、meetings.space.readonly、openid、email。
# 保存连接只要求三个日历范围。Gmail 和 Drive 缺失时日历连接仍保存，会前简报会要求重新授权。
# 没有 meetings.space.readonly 时，会后跟进跳过 Meet 智能纪要，不要求为 Meet 重新连接。
# 另外请求 openid 和 email，用来从令牌交换返回的 id_token 确认 Google 账户。
# 只申请日历范围时，access token 的 tokeninfo 经常没有 sub，同意之后连接会失败。
# 在 Google Cloud 同意屏幕的范围里加上 openid、email（控制台里是
# https://www.googleapis.com/auth/userinfo.email）、gmail.readonly、drive.readonly 和
# meetings.space.readonly。
# drive.readonly 是受限范围，验证可以晚于代码。没配好时文档区说明原因，不假装没有文档。
# 回调必须与 Google Cloud 控制台登记的地址一致，路径为 /api/calendar/google/callback。
# 浏览器要带着登录会话回来：Vite 开发时用前端源（cookie 在 5173），反代部署用对外主机。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/calendar/google/callback
# Fernet 密钥（urlsafe base64 的 32 字节）。只签 state 的 SECRET_KEY 不能代替它。
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 配了 GOOGLE_OAUTH_CLIENT_ID 却空着此项时，ENFORCE_SECURE_SECRETS=true 会拒绝启动。
CALENDAR_TOKEN_KEY=

# ---- 存储 ----
# 生产推荐 Postgres（docker compose 内置服务；schema 用 alembic upgrade head 管理）
# 宿主机 venv 可用 omni 超管。Compose 会覆盖为 omni_app，使 RLS 生效；
# 迁移走 DATABASE_MIGRATE_URL（compose 已设成 omni）。
DATABASE_URL=postgresql+psycopg://omni:omni@localhost:5432/omni_butler
# 改库口令时写在 docker-compose.yml 同级 .env（不是只改 backend/.env）：
# POSTGRES_PASSWORD=
# POSTGRES_APP_PASSWORD=
# Compose 栈内（由 docker-compose.yml environment 覆盖，不必改本文件）：
# DATABASE_URL=postgresql+psycopg://omni_app:...@postgres:5432/omni_butler
# DATABASE_MIGRATE_URL=postgresql+psycopg://omni:...@postgres:5432/omni_butler
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# S3_ENDPOINT=http://minio:9000
# 无 Docker 快速起步可用 SQLite（测试始终强制 SQLite，不受此项影响）：
# DATABASE_URL=sqlite:///./omni_butler.db
# 连接池（仅 Postgres 生效）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=omni_chunks
# 用户上传只存 MinIO / S3；项目和宿主机目录均不持久化原文件
# 宿主机 venv 用 localhost；docker compose 会覆盖为服务名 postgres/redis/qdrant/minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=omni-uploads
S3_REGION=us-east-1

# ---- 异步/缓存 ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
# 精确缓存 TTL（秒）：路由 3 天、query embedding 7 天、联网搜索 5 分钟
ROUTER_CACHE_TTL=259200
EMBEDDING_CACHE_TTL=604800
WEB_CACHE_TTL=300
# /api/chat 每用户滑动窗口限流
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=60
# 分布式模型并发：未列出的模型默认 10；按供应商权益设置精确上限
LLM_CONCURRENCY_DEFAULT=10
LLM_MODEL_CONCURRENCY_LIMITS=deepseek-flash=50,deepseek-v4-pro=10,embedding-3-pro=100,glm-4v-flash=50,rerank=100,web-search=10
LLM_SLOT_LEASE_SECONDS=180
# Celery：文档入库队列（空则复用 REDIS_URL）。pytest 强制 EAGER，生产不要开。
# CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_INGEST_SOFT_TIME_LIMIT=1740
CELERY_INGEST_TIME_LIMIT=1800
CELERY_STALE_AFTER_SECONDS=3600
CELERY_STALE_CHECK_SECONDS=300

# ---- 行为 ----
MAX_CONTEXT_TURNS=10
# ContextManager（H5）：预算上限 ≠ 模型物理窗口；false 时退回纯滑动窗口
CONTEXT_MANAGER_ENABLED=true
CONTEXT_MAX_TOKENS=32000
CONTEXT_RESERVE_RATIO=0.25
CONTEXT_WARN_RATIO=0.70
CONTEXT_COMPACT_RATIO=0.85
CONTEXT_EMERGENCY_RATIO=0.95
CONTEXT_CJK_CHARS_PER_TOKEN=1.6
CONTEXT_LATIN_CHARS_PER_TOKEN=4.0
CONTEXT_SUMMARY_ENABLED=true
CONTEXT_SUMMARY_MAX_CHARS=1200
CONTEXT_SUMMARY_MIN_OVERFLOW_TURNS=2
CONTEXT_ROUTER_TURNS=3
CONTEXT_ROUTER_CHARS=300
CONTEXT_TOOL_TURNS=4
CONTEXT_WORKING_STATE_MAX_CHARS=600
CONTEXT_POOL_CHARS_WARN=8000
CONTEXT_POOL_CHARS_EMERGENCY=4000
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RAG_TOP_K=6
RAG_VECTOR_TOP_K=8
RAG_HYBRID_ENABLED=true
# retrieval-resume：候选 → 邻接扩展 → 智谱 Rerank → top_k
RAG_CANDIDATE_K=20
RAG_EXPAND_WINDOW=1
RAG_EXPAND_MAX_CHARS=2400
RAG_RERANK_ENABLED=true
RAG_RERANK_PROVIDER=zhipu
# 智谱 Rerank 的地址和密钥，同样不是 LLM_* 的别名。RAG_RERANK_ENABLED=true 且
# PROVIDER 为 zhipu / auto 时必填；设 RAG_RERANK_ENABLED=false 则用本地启发式排序
RERANK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
RERANK_API_KEY=
RERANK_MODEL=rerank
MAX_UPLOAD_MB=20
# 联网搜索（智谱 Web Search API；引擎可用 search_std / search_pro）
WEB_SEARCH_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE=search_pro_quark
WEB_SEARCH_COUNT=5
# 数据分析沙箱（Compose：docker compose build sandbox）
SANDBOX_ENABLED=true
SANDBOX_IMAGE=omni-sandbox
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MEMORY=256m
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_RETRIES=3
# Compose api 容器与宿主机共享此目录，供 docker -v 挂载沙箱临时文件；宿主机 venv 请留空
# SANDBOX_TMP_DIR=/var/omni-tmp
# Compose 会把 API 的 SANDBOX_RUNNER_URL 设成 http://sandbox-runner:8002；venv 方案 B 留空
# SANDBOX_RUNNER_URL=
# 长期记忆（Phase 4 MVP：跨会话身份/偏好/实体；MEMORY_USE_LLM=false 仅启发式抽取）
MEMORY_ENABLED=true
MEMORY_USE_LLM=true
MEMORY_MAX_CHARS=800
# 自动抽取只写用户画像（身份/偏好/稳定实体），不把每轮对话当成记忆
MEMORY_MAX_ITEMS=40
# 敏感词：输入命中直接拒绝，输出命中替换为 ***。SENSITIVE_WORDS 为额外词，逗号分隔
SENSITIVE_FILTER_ENABLED=true
SENSITIVE_USE_BUILTIN=true
SENSITIVE_WORDS=
# csv/xlsx 全表分块入库上限（超出会截断并在文档 warning 中提示；旧文档需「重新解析」）
TABULAR_MAX_ROWS=5000
TABULAR_MAX_CHARS=800000
TABULAR_BATCH_ROWS=40
CORS_ORIGINS=http://localhost:5173
