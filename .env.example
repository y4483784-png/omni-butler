# ---- LLM（provider-agnostic，走 OpenAI 兼容端点）----
# 留空则后端以"演示模式"运行（mock 流式回复，无需 key 即可端到端跑通）
#
# 你当前使用的是【智谱 GLM】：
#   1) LLM_API_KEY 填你的智谱 key（也可保留旧字段 OPENAI_API_KEY，已向后兼容）
#   2) LLM_BASE_URL 必须指向智谱的 OpenAI 兼容端点
#   3) LLM_MODEL 建议用专属权益高并发模型（如 glm-4-air）；批跑评测优先并发而非最强模型
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-air
LLM_TIMEOUT=120
# PRD：LLM 超时自动重试 3 次后再向用户报错
LLM_MAX_RETRIES=3
# 工具路由：严格 schema 约束的 LLM 判定（无正则兜底，失败即报错）
# ROUTER_MODEL 空则回退 PLANNER_MODEL → LLM_MODEL；ROUTER_MAX_ATTEMPTS 为校验重试上限
PLANNER_MODEL=glm-4-flashx
ROUTER_MODEL=glm-4-flashx
ROUTER_MAX_ATTEMPTS=2
CHAT_MODEL=glm-4-flashx
# 依据核验：成稿后对照证据做 NLI；失败则带反馈再生成一次（false 则只附免责、不重写）
# GROUNDING_ENABLED=true
# GROUNDING_REPAIR_ENABLED=true
EMBEDDING_MODEL=embedding-3-pro
# 多模态 OCR：PDF 页有嵌入图即识别；无图但有效字极少时兜底 OCR
# VISION_MODEL：专属权益可用 glm-4v-flash；有 glm-4.6v 专属包时可改回
VISION_MODEL=glm-4v-flash
VISION_OCR_ENABLED=true
OCR_MIN_USEFUL_CHARS=40
OCR_MAX_PAGES=80

# 若改用官方 OpenAI，可改为：
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ---- 认证 / 多用户隔离 ----
# 生产务必修改 SECRET_KEY 与 ADMIN_PASSWORD；首次启动会用其创建/初始化管理员
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 生产必须改掉 SECRET_KEY / 管理员密码 / Postgres / MinIO 默认口令。
# 改完后可设 ENFORCE_SECURE_SECRETS=true，启动时若仍是默认值会拒绝起来。
ENFORCE_SECURE_SECRETS=false
# HTTPS 反代后可在 backend/.env 设 SESSION_COOKIE_SECURE=true

# ---- 存储 ----
# 生产推荐 Postgres（docker compose 内置服务；schema 用 alembic upgrade head 管理）
# 宿主机 venv 可用 omni 超管。Compose 会覆盖为 omni_app，使 RLS 生效；
# 迁移走 DATABASE_MIGRATE_URL（compose 已设成 omni）。
DATABASE_URL=postgresql+psycopg://omni:omni@localhost:5432/omni_butler
# 改库口令时写在 docker-compose.yml 同级 .env（不是只改 backend/.env）：
# POSTGRES_PASSWORD=
# POSTGRES_APP_PASSWORD=
# Compose 栈内（由 docker-compose.yml environment 覆盖，不必改本文件）：
# DATABASE_URL=postgresql+psycopg://omni_app:...@postgres:5432/omni_butler
# DATABASE_MIGRATE_URL=postgresql+psycopg://omni:...@postgres:5432/omni_butler
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# S3_ENDPOINT=http://minio:9000
# 无 Docker 快速起步可用 SQLite（测试始终强制 SQLite，不受此项影响）：
# DATABASE_URL=sqlite:///./omni_butler.db
# 连接池（仅 Postgres 生效）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=omni_chunks
# 用户上传只存 MinIO / S3；项目和宿主机目录均不持久化原文件
# 宿主机 venv 用 localhost；docker compose 会覆盖为服务名 postgres/redis/qdrant/minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=omni-uploads
S3_REGION=us-east-1

# ---- 异步/缓存 ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
# 精确缓存 TTL（秒）：路由 3 天、query embedding 7 天、联网搜索 5 分钟
ROUTER_CACHE_TTL=259200
EMBEDDING_CACHE_TTL=604800
WEB_CACHE_TTL=300
# /api/chat 每用户滑动窗口限流
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=60
# 分布式模型并发：未列出的模型默认 10；按供应商权益设置精确上限
LLM_CONCURRENCY_DEFAULT=10
LLM_MODEL_CONCURRENCY_LIMITS=glm-4-air=100,glm-4-flashx=50,embedding-3-pro=100,glm-4v-flash=50,rerank=100,web-search=10
LLM_SLOT_LEASE_SECONDS=180
# Celery：文档入库队列（空则复用 REDIS_URL）。pytest 强制 EAGER，生产不要开。
# CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_INGEST_SOFT_TIME_LIMIT=1740
CELERY_INGEST_TIME_LIMIT=1800
CELERY_STALE_AFTER_SECONDS=3600
CELERY_STALE_CHECK_SECONDS=300

# ---- 行为 ----
MAX_CONTEXT_TURNS=10
# ContextManager（H5）：预算上限 ≠ 模型物理窗口；false 时退回纯滑动窗口
CONTEXT_MANAGER_ENABLED=true
CONTEXT_MAX_TOKENS=32000
CONTEXT_RESERVE_RATIO=0.25
CONTEXT_SUMMARY_ENABLED=true
CONTEXT_SUMMARY_MAX_CHARS=1200
CONTEXT_ROUTER_TURNS=3
CONTEXT_ROUTER_CHARS=300
CONTEXT_TOOL_TURNS=4
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RAG_TOP_K=6
RAG_VECTOR_TOP_K=8
RAG_HYBRID_ENABLED=true
# retrieval-resume：候选 → 邻接扩展 → 智谱 Rerank → top_k
RAG_CANDIDATE_K=20
RAG_EXPAND_WINDOW=1
RAG_EXPAND_MAX_CHARS=2400
RAG_RERANK_ENABLED=true
RAG_RERANK_PROVIDER=zhipu
RERANK_MODEL=rerank
MAX_UPLOAD_MB=20
# 联网搜索（智谱 Web Search API；引擎可用 search_std / search_pro）
WEB_SEARCH_ENGINE=search_pro_quark
WEB_SEARCH_COUNT=5
# 数据分析沙箱（Compose：docker compose build sandbox）
SANDBOX_ENABLED=true
SANDBOX_IMAGE=omni-sandbox
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MEMORY=256m
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_RETRIES=3
# Compose api 容器与宿主机共享此目录，供 docker -v 挂载沙箱临时文件；宿主机 venv 请留空
# SANDBOX_TMP_DIR=/var/omni-tmp
# Compose 会把 API 的 SANDBOX_RUNNER_URL 设成 http://sandbox-runner:8002；venv 方案 B 留空
# SANDBOX_RUNNER_URL=
# 长期记忆（Phase 4 MVP：跨会话身份/偏好/实体；MEMORY_USE_LLM=false 仅启发式抽取）
MEMORY_ENABLED=true
MEMORY_USE_LLM=true
MEMORY_MAX_CHARS=800
# 自动抽取只写用户画像（身份/偏好/稳定实体），不把每轮对话当成记忆
MEMORY_MAX_ITEMS=40
# 敏感词：输入命中直接拒绝，输出命中替换为 ***。SENSITIVE_WORDS 为额外词，逗号分隔
SENSITIVE_FILTER_ENABLED=true
SENSITIVE_USE_BUILTIN=true
SENSITIVE_WORDS=
# csv/xlsx 全表分块入库上限（超出会截断并在文档 warning 中提示；旧文档需「重新解析」）
TABULAR_MAX_ROWS=5000
TABULAR_MAX_CHARS=800000
TABULAR_BATCH_ROWS=40
CORS_ORIGINS=http://localhost:5173
